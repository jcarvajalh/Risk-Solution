# Los 'sha256-...' de script-src autorizan los scripts INLINE que Astro emite
# (cargadores de hidratación de islas + los <script> del header, el carrusel, el
# zoom de imágenes y el filtro de blog). Son estáticos por versión de Astro y por
# contenido del script; sin ellos, con script-src 'self' Cloudflare los bloquea y
# la funcionalidad muere EN SILENCIO en producción (sin error visible, solo deja
# de funcionar). En dev/preview no se nota porque _headers no se aplica ahí.
#
# ⚠️ Cada vez que toques un <script> de un .astro (o subas la versión de Astro)
# cambia su hash y HAY QUE REGENERAR esta lista. Regenerar con:
#   pnpm build && node -e "const fs=require('fs'),p=require('path'),c=require('crypto');const w=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>{const x=p.join(d,e.name);return e.isDirectory()?w(x):[x]});const re=/<script(\s[^>]*)?>([\s\S]*?)<\/script>/g;const s=new Set();for(const f of w('dist').filter(f=>f.endsWith('.html'))){const h=fs.readFileSync(f,'utf8');let m;while(m=re.exec(h)){const a=m[1]||'';if(/src\s*=/.test(a)||/application\/ld\+json/.test(a)||m[2].trim()==='')continue;s.add(c.createHash('sha256').update(m[2],'utf8').digest('base64'))}}for(const h of s)console.log(\"'sha256-\"+h+\"'\")"
#
# Inventario actual (regenerado 2026-09-14, Astro 7.1.6):
#   BF0290pk… cargador de hidratación client:idle
#   Ya0pUYrC… runtime de hidratación de islas React
#   Q2BPg90Z… cargador de hidratación client:visible
#   bxTi8wnB… Header: toggle de rs-header-scrolled al hacer scroll
#   3G1WELS3… Ecosystem: carrusel de módulos (deriva automática + flechas)
#   X83+5WYk… ZoomableImage: <dialog> de las capturas de módulo
#   4vGmeIOR… Blog: filtro por categoría
