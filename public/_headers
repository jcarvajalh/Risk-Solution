# Los 'sha256-...' de script-src autorizan los scripts INLINE que Astro emite
# (cargadores de hidratación de islas + los <script> del carrusel y del filtro de
# blog). Son estáticos por versión de Astro/código; sin ellos, con script-src
# 'self' Cloudflare los bloquea y las islas React NO hidratan en producción (el
# formulario de contacto cae al envío nativo). En dev/preview no se nota porque
# _headers no se aplica ahí. Si cambian esos scripts o se sube Astro, regenerar:
#   pnpm build && node -e "const fs=require('fs'),p=require('path'),c=require('crypto');const w=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>{const x=p.join(d,e.name);return e.isDirectory()?w(x):[x]});const re=/<script(\s[^>]*)?>([\s\S]*?)<\/script>/g;const s=new Set();for(const f of w('dist').filter(f=>f.endsWith('.html'))){const h=fs.readFileSync(f,'utf8');let m;while(m=re.exec(h)){const a=m[1]||'';if(/src\s*=/.test(a)||/application\/ld\+json/.test(a)||m[2].trim()==='')continue;s.add(c.createHash('sha256').update(m[2],'utf8').digest('base64'))}}for(const h of s)console.log(\"'sha256-\"+h+\"'\")"
