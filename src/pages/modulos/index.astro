---
/**
 * Listado de módulos (/modulos). ESQUELETO: monta el Header en su variante sólida
 * (páginas interiores, fondo blanco) y el Footer. El contenido de la sección —las
 * 7 tarjetas de módulo— queda pendiente: los slugs y los campos del detalle no
 * están confirmados (pendientes 1 y 4 del CLAUDE.md). No se inventan.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

const seo = {
  title: "Módulos — Risk Solution",
  // TODO: meta description 140–160 caracteres cuando se confirme el copy.
};
---

<BaseLayout seo={seo}>
  <Header slot="header" variant="solid" />

  <section
    class="mx-auto w-full max-w-[1060px] px-5 py-[clamp(2.5rem,1.8rem_+_3vw,5rem)] sm:px-6"
  >
    <h1
      class="text-[clamp(1.75rem,1.486rem_+_1.13vw,2.75rem)] leading-[1.2] font-bold tracking-[-0.04em] text-ink"
    >
      Módulos
    </h1>

    {/* TODO: 7 tarjetas de módulo desde la colección `modules` (pendientes 1 y 4). */}
  </section>

  <Footer slot="footer" />
</BaseLayout>
