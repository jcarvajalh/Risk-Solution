---
/**
 * Página de Contacto (/contacto). Header sólido + encabezado + tarjetas de
 * contacto + mapa/formulario + Footer.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import ContactHero from "./_sections/ContactHero.astro";
import ContactInfo from "./_sections/ContactInfo.astro";
import ContactFormSection from "./_sections/ContactFormSection.astro";
import Footer from "@components/layout/Footer.astro";

const seo = {
  title: "Contacto — Risk Solution",
  description:
    "Ponte en contacto con el equipo de Risk Solution. Escríbenos y te ayudamos con la gestión de riesgo financiero de tu entidad.",
};
---

<BaseLayout seo={seo}>
  <Header slot="header" variant="solid" />

  <ContactHero />
  <ContactInfo />
  <ContactFormSection />

  <Footer slot="footer" />
</BaseLayout>
