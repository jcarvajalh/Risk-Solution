---
/**
 * Encabezado de la página de contacto: solo el título "Ponte en contacto…".
 * Sección de página (patrón 6.3): lee de site.ts.
 *
 * Mapeo Figma (1440px): sin eyebrow y sin padding superior. Título 30/400 #000
 * → text-ink (peso normal) a 30px, en un único renglón (contenedor sin ancho
 * máximo). En móvil escala hacia abajo y puede envolver. El espacio inferior
 * (~40px en desktop) es la separación hacia el formulario.
 */
import { contactHero } from "@config/site";

const { title } = contactHero;
---

<section class="bg-bg pt-[clamp(1.5rem,2.8vw,2.5rem)] pb-[clamp(1.5rem,2.8vw,2.5rem)]">
  <div class="mx-auto w-full px-5 text-center sm:px-6">
    <h1
      class="text-[clamp(1.375rem,3.2vw,1.875rem)] leading-[1.29] font-normal tracking-[-0.04em] text-ink"
    >
      {title}
    </h1>
  </div>
</section>
