---
/**
 * Sección "Lo que dicen nuestros clientes" (testimonios). Encabezado centrado +
 * dos testimonios en columnas. El encabezado lee de site.ts (patrón de datos
 * 6.3) y los testimonios de la content collection `testimonials`.
 *
 * Mapeo Figma (referencia, no copia literal):
 * - Layout con flex/grid, sin position:absolute ni alturas fijas. Contenido de
 *   928px centrado; en móvil las columnas se apilan.
 * - Fondo #F7F7F7 → bg-bg. Título #155EEF → text-primary. Texto #555 →
 *   ink-secondary. Nombre #000 → text-ink. Badge → componente Badge (primary).
 * - El export de Figma trae el título en 'Inter'; se usa Geist, que es la única
 *   familia del proyecto (regla 4.1).
 * - Escala desktop: el valor de Figma (medido a 1440px) queda en el tramo medio
 *   de cada clamp(), de modo que la sección respira de 1280 a 1920+ sin
 *   romperse.
 */
import { getCollection } from "astro:content";
import { testimonialsSection } from "@config/site";
import Badge from "@components/ui/Badge.astro";
import TestimonialCard from "./TestimonialCard.astro";

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order,
);

/* Figma 42px */
const fluidPadY = "py-[clamp(2.5rem,1.6rem_+_1.1vw,3.5rem)]";
/* Figma 18px (badge → título) */
const fluidGapSm = "mt-[clamp(0.875rem,0.79rem_+_0.38vw,1.375rem)]";
/* Figma 47px (encabezado → testimonios) */
const fluidGapLg = "mt-[clamp(2rem,1.67rem_+_1.41vw,3.5rem)]";
/* Figma 40px */
const fluidTitle = "text-[clamp(1.75rem,1.486rem_+_1.13vw,2.75rem)]";
/* Figma 50px (separación entre columnas) */
const fluidColGap = "md:gap-x-[clamp(2rem,3.47vw,4rem)]";
---

<section
  id="testimonios"
  class:list={["bg-bg", fluidPadY]}
  aria-labelledby="testimonios-titulo"
>
  <div class="mx-auto w-full max-w-[928px] px-5 sm:px-6">
    <!-- Encabezado -->
    <div class="flex flex-col items-center text-center">
      <Badge variant="primary">{testimonialsSection.eyebrow}</Badge>

      <h2
        id="testimonios-titulo"
        class:list={[
          "max-w-[551px] leading-[1.2] font-bold tracking-[-0.04em] text-balance text-primary",
          fluidGapSm,
          fluidTitle,
        ]}
      >
        {testimonialsSection.title}
      </h2>
    </div>

    <!-- Testimonios -->
    <ul
      class:list={[
        "grid grid-cols-1 gap-y-12 md:grid-cols-2",
        fluidGapLg,
        fluidColGap,
      ]}
    >
      {
        testimonials.map((testimonial) => (
          <li>
            <TestimonialCard testimonial={testimonial.data} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
