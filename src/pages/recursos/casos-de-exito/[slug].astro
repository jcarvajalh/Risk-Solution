---
/**
 * Detalle de un caso de éxito (/recursos/casos-de-exito/[slug]). El slug es el
 * nombre del archivo en la colección `case-studies`. Diseño tipo REVISTA: logo +
 * titular + metadatos + resumen, imagen destacada, cuerpo del artículo (markdown
 * con capitular y pull quotes vía .rs-article) y galería de imágenes.
 *
 * Sin FAQs ni CTA (a diferencia del listado): el detalle se cuenta a sí mismo.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import AppImage from "@components/ui/AppImage.astro";
import { Icon } from "astro-icon/components";
import { breadcrumbList } from "@lib/structured-data";

export async function getStaticPaths() {
  const studies = await getCollection("case-studies", ({ data }) => !data.draft);
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { title, client, description, publishDate, image, logo, sector, location, gallery } =
  study.data;

const { Content } = await render(study);

const meses = [
  "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
  "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
];
const fecha = `${meses[publishDate.getUTCMonth()]} ${publishDate.getUTCDate()}, ${publishDate.getUTCFullYear()}`;

// Imagen destacada = primera de la galería; el resto va a la galería inferior.
const featured = gallery[0] ?? image;
const restGallery = gallery.slice(1);

const meta = [sector, location, fecha].filter(Boolean) as string[];

const seo = {
  title: `${title} — Risk Solution`,
  description,
};

const breadcrumb = breadcrumbList([
  { name: "Inicio", url: "/" },
  { name: "Casos de éxito", url: "/recursos/casos-de-exito" },
  { name: client, url: `/recursos/casos-de-exito/${study.id}` },
]);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  about: client,
};
---

<BaseLayout seo={seo}>
  <Header slot="header" variant="solid" />

  <article class="bg-bg pb-[clamp(3rem,6vw,5.5rem)]">
    <div class="mx-auto w-full max-w-[1080px] px-5 sm:px-6">
      <!-- Volver -->
      <a
        href="/recursos/casos-de-exito"
        class="mt-[clamp(1.5rem,3vw,2.5rem)] inline-flex items-center gap-1.5 text-sm font-medium tracking-[-0.02em] text-ink-secondary transition-colors hover:text-primary"
      >
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        Casos de éxito
      </a>

      <!-- Encabezado tipo revista -->
      <header class="mx-auto mt-[clamp(1.5rem,3vw,2.5rem)] max-w-[820px] text-center">
        {
          logo && (
            <div class="flex justify-center">
              <AppImage
                name={logo}
                alt={`Logo de ${client}`}
                class="h-9 w-auto object-contain sm:h-10"
              />
            </div>
          )
        }

        <p class="mt-6 text-sm font-semibold tracking-[0.08em] text-primary uppercase">
          Caso de éxito
        </p>

        <h1
          class="mt-3 text-[clamp(1.875rem,1.3rem_+_2.4vw,3.25rem)] leading-[1.15] font-semibold tracking-[-0.04em] text-balance text-ink"
        >
          {title}
        </h1>

        {
          meta.length > 0 && (
            <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm tracking-[-0.02em] text-ink-muted">
              {meta.map((m, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{m}</span>
                </>
              ))}
            </p>
          )
        }

        <p
          class="mx-auto mt-6 max-w-[680px] text-[clamp(1.125rem,1rem_+_0.5vw,1.375rem)] leading-[1.5] tracking-[-0.02em] text-pretty text-ink-secondary"
        >
          {description}
        </p>
      </header>

      <!-- Imagen destacada -->
      {
        featured && (
          <div class="mt-[clamp(2rem,4vw,3.5rem)] overflow-hidden rounded-[14px]">
            <AppImage
              name={featured}
              alt={`${client} — imagen destacada`}
              class="aspect-[16/9] w-full object-cover"
              loading="eager"
            />
          </div>
        )
      }

      <!-- Cuerpo del artículo -->
      <div class="rs-article rs-article--lead mx-auto mt-[clamp(2.5rem,5vw,4rem)] max-w-[720px]">
        <Content />
      </div>

      <!-- Galería -->
      {
        restGallery.length > 0 && (
          <div class="mt-[clamp(2.5rem,5vw,4rem)] grid grid-cols-1 gap-[clamp(1rem,2vw,1.5rem)] sm:grid-cols-2">
            {restGallery.map((img, i) => (
              <div class="overflow-hidden rounded-[14px]">
                <AppImage
                  name={img}
                  alt={`${client} — imagen ${i + 2}`}
                  class="aspect-[4/3] w-full object-cover"
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
