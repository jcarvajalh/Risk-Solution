---
/**
 * Listado de casos de éxito: grilla de tarjetas. Lee de la colección
 * `case-studies` (solo clientes confirmados, sección 2 del CLAUDE.md). Sin
 * filtros: a diferencia del blog, los casos no se clasifican por tipo.
 *
 * Grilla de 3 columnas (2 en sm, 1 en móvil), igual que el listado del blog.
 */
import { getCollection } from "astro:content";
import CaseStudyCard from "./CaseStudyCard.astro";

const studies = (
  await getCollection("case-studies", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<section class="bg-bg pt-[clamp(2.5rem,5.7vw,5.125rem)]">
  <div class="mx-auto w-full max-w-[1080px] px-5 sm:px-6">
    {
      studies.length > 0 ? (
        <ul class="grid grid-cols-1 gap-[clamp(1.25rem,2.2vw,2rem)] sm:grid-cols-2 lg:grid-cols-3">
          {studies.map((study) => (
            <li>
              <CaseStudyCard study={study} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-[clamp(1rem,0.95rem_+_0.2vw,1.125rem)] tracking-[-0.02em] text-ink-secondary">
          Pronto publicaremos casos de éxito de nuestros clientes.
        </p>
      )
    }
  </div>
</section>
