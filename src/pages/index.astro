---
/**
 * Home. El Header se monta sobre el hero mediante el slot "header" del layout
 * (queda como hermano de <main>, semántica correcta, y visualmente encima del
 * hero gracias a su posicionamiento).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Hero from "@components/sections/Hero.astro";
import Problem from "@components/sections/Problem.astro";
---

<BaseLayout>
  <Header slot="header" />

  <Hero />
  <Problem />

  <!-- TODO: siguientes secciones del home (clientes, módulos, etc.). -->
</BaseLayout>
