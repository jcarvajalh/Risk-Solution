---
/**
 * Home. PLACEHOLDER provisional para que el proyecto arranque. Se construirá
 * sección por sección desde Figma (pendiente en el estado del proyecto).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-4xl font-bold text-ink">Risk Solution</h1>
    <p class="mt-4 text-lg text-primary">
      Estructura inicial lista. Contenido pendiente de construir desde Figma.
    </p>
  </section>
</BaseLayout>
