---
/**
 * Encabezado (hero) de una página de módulo. Bloque propio de las páginas de
 * módulo (components/modules). RECIBE props porque su contenido cambia por
 * módulo (excepción del patrón 6.3, igual que FAQSection/CTABanner): los datos
 * llegan desde la colección `modules` a través de ModuleLayout.
 *
 * Mapeo Figma (referencia, no copia literal — layout con flex, sin position
 * absolute, mobile-first, tipografía y espaciado fluidos):
 * - Fondo #F7F7F7 → bg-bg. Título 64/600, #1F1F1F → text-ink, clamp() centrado
 *   en ~64px a 1440. Descripción 20/400, #1F1F1F → text-ink, medida ~727px.
 * - Chips: borde 1px dashed #155EEF, radio 20px, texto 12/600 #155EEF →
 *   border-dashed border-primary + rounded-full + text-primary. En <sm se
 *   envuelven en varias filas.
 * - CTA "Hablar con un experto" → primitivo Button (variant primary): 173×38 con
 *   círculo y flecha.
 * - Los cuatro bloques (título, descripción, chips, CTA) llevan la misma
 *   separación vertical (~25px en Figma) → un único gap fluido en la columna.
 */
import Button from "@components/ui/Button.astro";

interface Props {
  title: string;
  description: string;
  /** Etiquetas (chips) con borde punteado. */
  highlights?: string[];
  /** CTA; por defecto "Hablar con un experto" → /contacto. */
  cta?: { label: string; href: string };
}

const {
  title,
  description,
  highlights = [],
  cta = { label: "Hablar con un experto", href: "/contacto" },
} = Astro.props;
---

<section class="bg-bg">
  <div
    class="mx-auto flex max-w-[750px] flex-col items-center gap-[clamp(1rem,0.6rem_+_1.1vw,1.5625rem)] py-[clamp(3rem,1.8rem_+_5vw,6rem)] text-center"
  >
    <h1
      class="text-[64px] leading-[1.3] font-semibold tracking-[-0.04em] whitespace-nowrap text-ink"
    >
      {title}
    </h1>

    <p
      class="max-w-[727px] text-[20px] leading-[1.5] tracking-[-0.04em] text-pretty text-ink"
    >
      {description}
    </p>

    {
      highlights.length > 0 && (
        <ul class="flex flex-wrap justify-center gap-x-[clamp(0.75rem,1.5vw,1.375rem)] gap-y-3">
          {highlights.map((label: string) => (
            <li class="inline-flex items-center rounded-full border border-dashed border-primary px-3.5 py-[9px] text-xs font-semibold tracking-[-0.02em] whitespace-nowrap text-primary">
              {label}
            </li>
          ))}
        </ul>
      )
    }

    <Button href={cta.href} label={cta.label} variant="primary" />
  </div>
</section>
