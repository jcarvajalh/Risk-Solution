---
/**
 * Sección "Beneficios" de la página de módulo: título + 3 beneficios numerados
 * (línea superior azul, número, título y descripción) + CTA. Datos desde la
 * colección `modules` (module.data.benefits) vía ModuleLayout. Recibe props
 * (excepción del patrón 6.3, contenido por módulo).
 *
 * Mapeo Figma (referencia, no copia literal — flex/grid, sin position absolute,
 * mobile-first, tipografía y espaciado fluidos):
 * - Sección bg #FFFFFF → bg-surface; borde superior e inferior rgba(0,0,0,0.2)
 *   → border-ink/20 (token ink con opacidad, valor exacto).
 * - Título 40/700 (Inter) #1F1F1F → Geist, text-ink, clamp centrado en 40px @1440.
 * - Número 20/700 ('JetBrains Mono') #155EEF → Geist + tabular-nums + text-primary
 *   (regla 4.1: Geist es la única familia, sin monoespaciada).
 * - Título de beneficio 24/600 #555 → text-ink-secondary. Descripción 13/400 #555
 *   → text-ink-secondary. Línea superior 0.5px #155EEF → border-primary.
 * - CTA → primitivo Button (variant primary). 3 columnas a ≥md; se apilan en móvil.
 */
import Button from "@components/ui/Button.astro";

interface BenefitItem {
  title: string;
  description: string;
}
interface Props {
  title: string;
  items: BenefitItem[];
  /** CTA; por defecto "Hablar con un experto" → /contacto. */
  cta?: { label: string; href: string };
}

const {
  title,
  items,
  cta = { label: "Hablar con un experto", href: "/contacto" },
} = Astro.props;
---

<section class="border-y border-ink/20 bg-surface">
  <div
    class="mx-auto w-full max-w-[1061px] px-5 py-[clamp(3rem,5.3vw,4.8125rem)] sm:px-6"
  >
    <h2
      class="text-center text-[clamp(1.75rem,1.486rem_+_1.13vw,2.75rem)] leading-[1.2] font-bold tracking-[-0.02em] text-balance text-ink"
    >
      {title}
    </h2>

    <ul
      class="mt-[clamp(2.5rem,4.5vw,4.0625rem)] grid grid-cols-1 gap-[clamp(1.5rem,2.8vw,2.5rem)] md:grid-cols-3"
    >
      {
        items.map((item: BenefitItem, i: number) => (
          <li class="flex flex-col border-t-[0.5px] border-primary pt-[clamp(1rem,1.5vw,1.375rem)]">
            <p class="text-xl leading-[1.3] font-bold tabular-nums tracking-[-0.02em] text-primary">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-[clamp(1.25rem,1.14rem_+_0.4vw,1.5rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-ink-secondary">
              {item.title}
            </h3>
            <p class="mt-2.5 text-[13px] leading-[1.54] tracking-[-0.02em] text-ink-secondary">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-[clamp(2.5rem,4.5vw,4.0625rem)] flex justify-center">
      <Button href={cta.href} label={cta.label} variant="primary" />
    </div>
  </div>
</section>
