---
/**
 * Sección "Beneficios" — banda azul a todo el ancho. Encabezado centrado
 * (badge + título + subtítulo con CTA) y una grilla de 4 beneficios.
 * Lee su contenido de site.ts (patrón de datos 6.3).
 *
 * Mapeo Figma (referencia, no copia literal):
 * - Fondo #155EEF → bg-primary. Textos claros → white / white/75.
 * - Título/benefits en Inter → Geist (font-sans), regla 4.1.
 * - CTA blanco sobre azul → Button variante light.
 * - Números 01–04 y líneas divisorias omitidos: en Figma están en #155EEF
 *   (= fondo), por lo que son invisibles. Ver nota en site.ts.
 */
import { benefits } from "@config/site";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
---

<section class="bg-primary py-section-y">
  <div class="mx-auto max-w-[1137px] px-5 sm:px-6">
    <!-- Encabezado -->
    <div class="flex flex-col items-center text-center">
      <Badge variant="light">{benefits.eyebrow}</Badge>

      <h2
        class="mt-6 text-3xl font-bold tracking-[-0.04em] text-white md:text-[40px] md:leading-[48px]"
      >
        {benefits.title}
      </h2>

      <div
        class="mt-6 flex flex-col items-center gap-5 sm:flex-row sm:justify-center"
      >
        <p
          class="text-base font-normal tracking-[-0.04em] text-white/75 md:text-xl md:leading-[26px]"
        >
          {benefits.subtitle}
        </p>
        <Button
          href={benefits.cta.href}
          label={benefits.cta.label}
          variant="light"
        />
      </div>
    </div>

    <!-- Beneficios: cada uno se ajusta a su contenido (título en una línea,
         descripción acotada) y se reparten con justify-between. -->
    <div
      class="mt-14 flex flex-col gap-y-10 md:mt-16 lg:flex-row lg:justify-between lg:gap-y-0"
    >
      {
        benefits.items.map((item) => (
          <div>
            <h3 class="text-2xl font-semibold tracking-[-0.04em] text-white lg:whitespace-nowrap">
              {item.title}
            </h3>
            <p class="mt-3 text-[13px] leading-5 tracking-[-0.04em] text-white lg:max-w-[200px]">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
