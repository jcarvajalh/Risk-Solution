---
/**
 * CTABanner — bloque de conversión que va antes del footer. Componente
 * RECICLABLE (6.2): se construye una vez y aparece en varias páginas con copy
 * distinto, así que su variabilidad se resuelve con props, nunca duplicándolo.
 * Sin props usa los valores por defecto de site.ts.
 *
 * Mapeo Figma (referencia, no copia literal):
 * - Layout con flex centrado, sin position:absolute ni alturas fijas: el alto
 *   lo manda el contenido más el padding.
 * - Fondo #155EEF → bg-primary. Título #FFFFFF → text-white. Botón blanco con
 *   círculo azul y flecha blanca → primitivo Button (variant light), que ya
 *   reproduce el 38px de alto y el radio de 5px.
 * - La descripción viene en 'Inter' en el export; se usa Geist (regla 4.1).
 * - DESVIACIÓN de accesibilidad: el gris #DBDBDB de la descripción da 3.91:1
 *   sobre el azul, por debajo del 4.5:1 que exige WCAG AA para texto normal
 *   (20px regular no califica como texto grande). Se usa white/90, que da
 *   4.69:1 y mantiene el mismo efecto de jerarquía suave.
 * - El padding vertical sale del frame de Figma (~100px), no del token
 *   `py-section-y`, que es el ritmo de 64px de las otras secciones.
 * - El contenedor es de 760px y no de los 648px del frame: al corregir el copy
 *   de la descripción (le faltaba el "cómo") el texto pasó de ~636px a ~681px y
 *   ya no cabía en una línea. El título mantiene su salto propio.
 */
import { ctaBanner } from "@config/site";
import Button from "@components/ui/Button.astro";

interface Props {
  titleLead?: string;
  /** Segunda línea del título. Si se omite, el título no fuerza salto. */
  titleTrail?: string;
  description?: string;
  cta?: { label: string; href: string };
}

const {
  titleLead = ctaBanner.titleLead,
  titleTrail = ctaBanner.titleTrail,
  description = ctaBanner.description,
  cta = ctaBanner.cta,
} = Astro.props;

/* Figma 100px */
const fluidPadY = "py-[clamp(3.5rem,6.9vw,7rem)]";
/* Figma 40px */
const fluidTitle = "text-[clamp(1.75rem,1.486rem_+_1.13vw,2.75rem)]";
/*
 * Figma 20px. El tope se queda en 20 y no crece: por encima, la descripción no
 * cabría en una línea, que es como debe leerse.
 */
const fluidDescription = "text-[clamp(1.0625rem,0.6rem_+_0.72vw,1.25rem)]";
/* Figma 17px (título → descripción) */
const fluidTitleGap = "mt-[clamp(0.75rem,1.18vw,1.25rem)]";
/* Figma 37px (descripción → botón) */
const fluidCtaGap = "mt-[clamp(1.5rem,2.57vw,2.5rem)]";
---

<section class:list={["bg-primary", fluidPadY]} aria-labelledby="cta-titulo">
  <div
    class="mx-auto flex w-full max-w-[760px] flex-col items-center px-5 text-center sm:px-6"
  >
    <h2
      id="cta-titulo"
      class:list={[
        "leading-[1.3] font-bold tracking-[-0.04em] text-white",
        fluidTitle,
      ]}
    >
      {titleLead}{" "}{
        titleTrail && (
          <>
            {/* El salto solo se fuerza en desktop; en móvil el texto fluye. */}
            <br class="hidden md:inline" />
            {titleTrail}
          </>
        )
      }
    </h2>

    <p
      class:list={[
        "leading-[1.2] tracking-[-0.04em] text-white/90",
        fluidTitleGap,
        fluidDescription,
      ]}
    >
      {description}
    </p>

    <Button
      href={cta.href}
      label={cta.label}
      variant="light"
      class={fluidCtaGap}
    />
  </div>
</section>
