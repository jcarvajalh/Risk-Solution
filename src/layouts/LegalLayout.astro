---
/**
 * Layout de las páginas legales (privacidad, cookies, tratamiento de datos). Lo
 * consumen las páginas markdown de `src/pages/*.md` vía su frontmatter `layout`.
 * Estructura: Header sólido + encabezado (título + última actualización) + cuerpo
 * en prosa (.rs-article) + Footer. El contenido llega por <slot /> desde el
 * markdown (Astro lo convierte a HTML; es contenido propio, no entrada de usuario,
 * así que renderizarlo es seguro — regla 7.2).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

interface LegalFrontmatter {
  title: string;
  description: string;
  heading: string;
  lastUpdated: string;
}

interface Props {
  frontmatter: LegalFrontmatter;
}

const { frontmatter } = Astro.props;
const seo = { title: frontmatter.title, description: frontmatter.description };
---

<BaseLayout seo={seo}>
  <Header slot="header" variant="solid" />

  <article class="mx-auto w-full max-w-[820px] px-5 py-section-y sm:px-6">
    <header class="mb-[clamp(2rem,4vw,3rem)]">
      <h1
        class="text-[clamp(1.875rem,1.4rem_+_1.8vw,2.75rem)] leading-[1.1] font-semibold tracking-[-0.03em] text-ink"
      >
        {frontmatter.heading}
      </h1>
      <p
        class="mt-3 text-sm tracking-[-0.02em] text-ink-muted"
      >
        Última actualización: {frontmatter.lastUpdated}
      </p>
    </header>

    <div class="rs-article">
      <slot />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
