---
/**
 * Layout base del sitio. ESQUELETO INICIAL: wiring de estilos, fuentes, SEO y
 * accesibilidad mínima. Falta el Header y el Footer (pendientes) y afinar con
 * Figma. Cumple: lang es-CO, un solo <main>, skip link, preload de fuentes.
 */
import "@styles/global.css";
import { SITE_LOCALE, defaultSeo } from "@config/seo";
import type { SeoMeta } from "@/types/index";

interface Props {
  seo?: Partial<SeoMeta>;
}

const { seo = {} } = Astro.props;
const meta: SeoMeta = { ...defaultSeo, ...seo };

const canonicalURL = new URL(
  meta.canonical ?? Astro.url.pathname,
  Astro.site,
).toString();
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalURL} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalURL} />
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload de los pesos usados en el primer pintado (400 y 500). -->
    <link
      rel="preload"
      href="/fonts/geist/Geist-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist/Geist-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Saltar al contenido</a>

    <!-- TODO: <Header /> -->

    <main id="main">
      <slot />
    </main>

    <!-- TODO: <Footer /> -->
  </body>
</html>
