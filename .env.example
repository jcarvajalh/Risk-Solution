# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los
# valores reales. NUNCA subas `.env` al repositorio (sección 7 del CLAUDE.md).
#
# Solo las variables con prefijo PUBLIC_ se exponen al cliente (son necesarias
# para EmailJS y reCAPTCHA, que corren en el navegador sin backend propio).

# EmailJS — formulario de contacto
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "Casilla invisible" (Site Key aquí; el Secret Key se guarda
# en el panel de EmailJS, nunca en el repo).
PUBLIC_RECAPTCHA_SITE_KEY=

# Google Tag Manager (GA4)
PUBLIC_GTM_ID=
